server {
    listen 8080;
    server_name _;

    # The sidecar needs exactly one Cloud operation. Keep the upstream fixed so
    # author code cannot turn this proxy into a general egress/SSRF channel.
    location = /token_api/get-dsls {
        limit_except GET {
            deny all;
        }
        proxy_pass ${CLOUD_UPSTREAM}token_api/get-dsls;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $proxy_host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Connection "";
        proxy_ssl_server_name on;
    }

    location / {
        return 403;
    }
}
